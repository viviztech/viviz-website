# Whole-site deployment uses the existing Coolify server; see docs/COOLIFY_DEPLOYMENT.md.
# Local example only. In Coolify use its PostgreSQL resource's private/internal URL.
# Restore the existing Neon database before starting migrations or the application.
# Never commit real credentials.
DATABASE_URL=postgresql://username:password@localhost:5432/viviz

# Public build values; changing these requires rebuilding the web image.
NEXT_PUBLIC_BASE_URL=https://viviz.in
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required private staff administration configuration. Preserve the existing values.
INVOICE_PASSWORD=
INVOICE_SESSION_SECRET=

# Preserve the existing live payment configuration during migration.
# If the old host uses aliases, COPY their values into these canonical names:
# SABPAISA_CLIENT_CODE -> SABPAISA_MERCHANT_ID
# SABPAISA_AUTH_KEY -> SABPAISA_API_KEY; SABPAISA_AUTH_IV -> SABPAISA_SECRET_KEY
SABPAISA_MERCHANT_ID=
SABPAISA_API_KEY=
SABPAISA_SECRET_KEY=
# Keep the existing live environment; prod for live payments, uat/stag for testing.
SABPAISA_ENV=uat

# Coolify/default mode: run the long-lived audit worker beside the website.
AUDIT_ENABLED=true
AUDIT_EXECUTION_MODE=standalone
# Prior unused Netlify option only; these are not needed by the Coolify stack.
# Netlify mode requires a fixed HTTPS worker endpoint and matching signing secret.
# Generate at least 32 random bytes; never prefix these variables with NEXT_PUBLIC_.
AUDIT_WORKER_URL=
AUDIT_WORKER_SECRET=
AUDIT_SESSION_DAILY_LIMIT=3
AUDIT_IP_DAILY_LIMIT=12
# Conservative initial capacity limit; monitor the existing server and database.
# Omitting this override retains the application's 100/day default.
AUDIT_GLOBAL_DAILY_LIMIT=5
AUDIT_MAX_CONCURRENT=2
AUDIT_ASSESSMENT_LIMIT=6

# Optional Google laboratory and real-user measurements.
AUDIT_PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=
AUDIT_CRUX_ENABLED=false
CRUX_API_KEY=

# Optional deeper Gemini explanations; missing key/quota/error uses the rules report.
# Only gemini-3.8-flash and gemini-3.5-flash-lite are accepted. No paid fallback/tools.
# Use a Google AI Studio project on the FREE tier; an API key cannot prove billing status.
# Public excerpts go to Google; free-tier data may improve Google's products.
AUDIT_AI_ENABLED=true
GEMINI_API_KEY=
AUDIT_AI_MODEL=gemini-3.8-flash
# Persistent global application request caps; failed attempts also count.
# These caps do not replace Google's account-specific quotas or billing settings.
AUDIT_AI_DAILY_LIMIT=20
AUDIT_AI_MINUTE_LIMIT=2

# Enquiries are saved before notification is attempted.
# Enable only after configuring a verified Resend sender and intended recipient.
AUDIT_SEND_EMAIL=false
RESEND_API_KEY=
AUDIT_FROM_EMAIL=Viviz Website <onboarding@resend.dev>
AUDIT_TO_EMAIL=viviztechnologies@gmail.com
